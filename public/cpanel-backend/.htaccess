# ==========================================================
# Configuración Apache / cPanel para Casanovia (casanovia.pe)
# ==========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permitir acceso directo a archivos existentes, carpetas y uploads
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Permitir acceso a la API en PHP
  RewriteRule ^api/(.*)$ api/$1 [L]

  # Redireccionar el resto de las rutas al index.html de React (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Habilitar compresión Gzip para mayor velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Seguridad: Evitar listar directorios
Options -Indexes
