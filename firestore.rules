rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.size() > 0;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Weddings collection (Multi-wedding support)
    match /weddings/{weddingId} {
      allow read: if true;
      allow create, update: if isValidId(weddingId);
      allow delete: if isValidId(weddingId);

      // Sub-collections if any
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // System Users collection (Authentication, Roles & RBAC)
    match /system_users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && 
        incoming().username is string && 
        incoming().username.size() > 0 &&
        incoming().clave is string &&
        incoming().clave.size() > 0;
      allow delete: if isValidId(userId);
    }

    // Guests collection (RSVP, search by code/name, management)
    match /guests/{guestId} {
      allow read: if true;
      allow create, update: if isValidId(guestId) && 
        incoming().fullName is string && 
        incoming().fullName.size() > 0 && 
        incoming().fullName.size() <= 200;
      allow delete: if isValidId(guestId);
    }

    // Timeline milestones
    match /timeline/{milestoneId} {
      allow read: if true;
      allow create, update: if isValidId(milestoneId) && 
        incoming().title is string && 
        incoming().title.size() > 0;
      allow delete: if isValidId(milestoneId);
    }

    // Budget items
    match /budget/{budgetItemId} {
      allow read: if true;
      allow create, update: if isValidId(budgetItemId) && 
        incoming().concept is string && 
        incoming().concept.size() > 0;
      allow delete: if isValidId(budgetItemId);
    }

    // Tasks checklist
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if isValidId(taskId) && 
        incoming().title is string && 
        incoming().title.size() > 0;
      allow delete: if isValidId(taskId);
    }

    // Wedding Settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }

    // System Configurations (Tokens payment, QR info, etc.)
    match /system_configs/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId);
      allow delete: if isValidId(configId);
    }

    // Uploaded images / vouchers collection (Visitor and user uploads)
    match /uploaded_images/{imageId} {
      allow read: if true;
      allow create, update: if isValidId(imageId);
      allow delete: if isValidId(imageId);
    }

    // Floor Plans collection (Wedding interactive floor plan layouts)
    match /floor_plans/{planId} {
      allow read: if true;
      allow create, update: if isValidId(planId);
      allow delete: if isValidId(planId);
    }


    // WeddingCraft Templates
    match /weddingcraft_templates/{templateId} {
      allow read: if true;
      allow create, update: if isValidId(templateId);
      allow delete: if isValidId(templateId);
    }

    // WeddingCraft Library
    match /weddingcraft_library/{elementId} {
      allow read: if true;
      allow create, update: if isValidId(elementId);
      allow delete: if isValidId(elementId);
    }

    // Test connection document
    match /test/{testId} {
      allow read: if true;
    }
  }
}
